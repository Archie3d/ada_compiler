export data $__ada_exception = align 4 { z 4 }
export data $__ada_exception_name = align 8 { z 8 }
data $.str.0 = { b "Hello, world!" 0 }

function $__ada_elaborate() {
@start
    ret
}

function $hello() {
@start
    call $__ada_put_line(l $.str.0, w 13)
    %.t5 =w loadsw $__ada_exception
    jnz %.t5, @propagate.1, @nothrow.2
@nothrow.2
    ret
@propagate.1
    ret
}

export function w $main() {
@start
    call $__ada_elaborate()
    %.t6 =w loadsw $__ada_exception
    jnz %.t6, @unhandled.4, @elaborated.5
@elaborated.5
    call $hello()
    %.t7 =w loadsw $__ada_exception
    jnz %.t7, @unhandled.4, @done.6
@unhandled.4
    %.t8 =l loadl $__ada_exception_name
    call $__ada_unhandled(l %.t8)
    ret 1
@done.6
    ret 0
}

